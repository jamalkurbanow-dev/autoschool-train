<script>
  (function() {
    const langBtns = document.querySelectorAll('.lang-btn');
    const ruElements = document.querySelectorAll('.lang-ru');
    const uzElements = document.querySelectorAll('.lang-uz');
    
    function setLanguage(lang) {
      if (lang === 'ru') {
        ruElements.forEach(el => el.style.display = '');
        uzElements.forEach(el => el.style.display = 'none');
        document.querySelectorAll('.lang-btn').forEach(btn => {
          if (btn.getAttribute('data-lang') === 'ru') btn.classList.add('active');
          else btn.classList.remove('active');
        });
      } else if (lang === 'uz') {
        ruElements.forEach(el => el.style.display = 'none');
        uzElements.forEach(el => el.style.display = '');
        document.querySelectorAll('.lang-btn').forEach(btn => {
          if (btn.getAttribute('data-lang') === 'uz') btn.classList.add('active');
          else btn.classList.remove('active');
        });
      }
    }
    
    langBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-lang');
        setLanguage(lang);
      });
    });
    
    // initial state: russian visible, uzbek hidden
    setLanguage('ru');
  })();
</script>
